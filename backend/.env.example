# Backend server
PORT=5000
NODE_ENV=development

# Use the exact host you use for Live Server (localhost OR 127.0.0.1)
FRONTEND_ORIGINS=http://127.0.0.1:5503,http://localhost:5503,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=beauty_bliss

# Replace with a long random secret before running
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d
